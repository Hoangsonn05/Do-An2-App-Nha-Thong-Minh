{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "(auth != null) && auth.uid === $uid",
        ".write": "(auth != null) && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['displayName','createdAt']) && ((!data.exists() && newData.child('createdAt').val() === now) || (data.exists() && data.child('createdAt').val() === newData.child('createdAt').val()))",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "(!data.exists() && newData.val() === now) || (data.exists() && data.val() === newData.val())"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userHomes": {
      "$uid": {
        ".read": "(auth != null) && auth.uid === $uid",
        "$homeId": {
          ".write": "(auth != null) && ((!data.exists() && newData.val() === 'owner' && auth.uid === $uid && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && root.child('homes').child($homeId).child('members').child($uid).child('role').val() === 'owner') || (!data.exists() && newData.val() === 'member' && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && root.child('homes').child($homeId).child('members').child($uid).child('role').val() === 'member') || (!newData.exists() && data.val() === 'member' && (auth.uid === $uid || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))))",
          ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'member')"
        }
      }
    },
    "homes": {
      "$homeId": {
        "meta": {
          ".read": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))",
          ".write": "(auth != null) && !data.exists() && newData.exists() && $homeId.matches(/^[A-Za-z0-9_-]{8,64}$/)",
          ".validate": "newData.hasChildren(['name','ownerUid','createdAt','schemaVersion'])",
          "name": {
            ".write": "(auth != null) && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && newData.exists()",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60 && !newData.val().contains('deviceKey')"
          },
          "ownerUid": {
            ".validate": "(!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === newData.val())"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "schemaVersion": {
            ".validate": "newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))",
          "$uid": {
            ".write": "(auth != null) && ((!data.exists() && newData.exists() && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) || (!newData.exists() && data.child('role').val() === 'member' && ((root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) || auth.uid === $uid)))",
            ".validate": "newData.hasChildren(['role','addedAt','addedBy'])",
            "role": {
              ".validate": "(newData.val() === 'owner' && $uid === root.child('homes').child($homeId).child('meta').child('ownerUid').val()) || (newData.val() === 'member' && $uid !== root.child('homes').child($homeId).child('meta').child('ownerUid').val())"
            },
            "addedAt": {
              ".validate": "newData.val() === now"
            },
            "addedBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "devices": {
          ".read": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))",
          "$deviceId": {
            ".write": "(auth != null) && !data.exists() && newData.exists() && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && $deviceId.matches(/^[A-Za-z0-9_-]{8,64}$/)",
            ".validate": "newData.hasChildren(['name','model','status','createdAt','createdBy'])",
            "name": {
              ".write": "(auth != null) && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && newData.exists()",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60 && !newData.val().contains('deviceKey')"
            },
            "model": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "status": {
              ".write": "(auth != null) && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && newData.exists()",
              ".validate": "(!data.exists() && (newData.val() === 'active' || newData.val() === 'revoked')) || (data.exists() && data.val() === 'active' && newData.val() === 'revoked')"
            },
            "deviceAuthUid": {
              ".write": "(auth != null) && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && !data.exists() && newData.exists()",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128 && !root.child('homes').child($homeId).child('members').child(newData.val()).exists() && newData.val() !== root.child('homes').child($homeId).child('meta').child('ownerUid').val()"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "createdBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "deviceData": {
          "$deviceId": {
            "state": {
              "gateway": {
                ".read": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))",
                ".write": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active') && newData.exists()",
                ".validate": "newData.hasChildren(['online','reportedBy','receivedAt','values']) && newData.child('reportedBy').val() === auth.uid && newData.child('receivedAt').val() === now",
                "online": {
                  ".validate": "newData.isBoolean()"
                },
                "reportedBy": {
                  ".validate": "newData.val() === auth.uid"
                },
                "receivedAt": {
                  ".validate": "newData.val() === now"
                },
                "deviceTs": {
                  ".validate": "newData.isNumber()"
                },
                "values": {
                  ".validate": "newData.hasChildren()",
                  "light": {
                    ".validate": "newData.isBoolean()"
                  },
                  "door": {
                    ".validate": "newData.isBoolean()"
                  },
                  "alarm": {
                    ".validate": "newData.isBoolean()"
                  },
                  "motion": {
                    ".validate": "newData.isBoolean()"
                  },
                  "monitoring": {
                    ".validate": "newData.isBoolean()"
                  },
                  "temp": {
                    ".validate": "newData.isNumber() && newData.val() > -50 && newData.val() < 150"
                  },
                  "hum": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                  },
                  "mode": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
                  },
                  "smokePpm": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
                  },
                  "smokeAlert": {
                    ".validate": "newData.isBoolean()"
                  },
                  "window": {
                    ".validate": "newData.isBoolean()"
                  },
                  "fan": {
                    ".validate": "newData.isBoolean()"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "$other": {
                  ".validate": false
                }
              },
              "device": {
                ".read": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))",
                ".write": "(auth != null) && (root.child('homes').child($homeId).child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active')) && newData.exists()",
                ".validate": "newData.hasChildren(['online','reportedBy','receivedAt','values']) && newData.child('reportedBy').val() === auth.uid && newData.child('receivedAt').val() === now",
                "online": {
                  ".validate": "newData.isBoolean()"
                },
                "reportedBy": {
                  ".validate": "newData.val() === auth.uid"
                },
                "receivedAt": {
                  ".validate": "newData.val() === now"
                },
                "deviceTs": {
                  ".validate": "newData.isNumber()"
                },
                "values": {
                  ".validate": "newData.hasChildren()",
                  "light": {
                    ".validate": "newData.isBoolean()"
                  },
                  "door": {
                    ".validate": "newData.isBoolean()"
                  },
                  "alarm": {
                    ".validate": "newData.isBoolean()"
                  },
                  "motion": {
                    ".validate": "newData.isBoolean()"
                  },
                  "monitoring": {
                    ".validate": "newData.isBoolean()"
                  },
                  "temp": {
                    ".validate": "newData.isNumber() && newData.val() > -50 && newData.val() < 150"
                  },
                  "hum": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                  },
                  "mode": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
                  },
                  "smokePpm": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
                  },
                  "smokeAlert": {
                    ".validate": "newData.isBoolean()"
                  },
                  "window": {
                    ".validate": "newData.isBoolean()"
                  },
                  "fan": {
                    ".validate": "newData.isBoolean()"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "config": {
              ".read": "(auth != null) && ((root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) || (root.child('homes').child($homeId).child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active')))",
              ".write": "(auth != null) && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid) && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active') && newData.exists()",
              ".validate": "newData.hasChildren(['rev','updatedBy','updatedAt','tempLimit','humLimit','coldLimit','autoAlarm']) && newData.child('rev').val() === (data.exists() ? data.child('rev').val() + 1 : 1) && newData.child('updatedBy').val() === auth.uid && newData.child('updatedAt').val() === now",
              "rev": {
                ".validate": "newData.isNumber()"
              },
              "updatedBy": {
                ".validate": "newData.val() === auth.uid"
              },
              "updatedAt": {
                ".validate": "newData.val() === now"
              },
              "tempLimit": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 80"
              },
              "humLimit": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "coldLimit": {
                ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 40"
              },
              "autoAlarm": {
                ".validate": "newData.isBoolean()"
              },
              "smokeLimit": {
                ".validate": "newData.isNumber() && newData.val() >= 50 && newData.val() <= 5000"
              },
              "smokeAuto": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },
            "telemetry": {
              ".read": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))",
              "$recordId": {
                ".write": "(auth != null) && ((!newData.exists() && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) || (!data.exists() && newData.exists() && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active') && (($recordId.matches(/^[0-9]{12}_g$/) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))) || ($recordId.matches(/^[0-9]{12}_d$/) && (root.child('homes').child($homeId).child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active'))))))",
                ".validate": "newData.hasChildren(['source','reportedBy','receivedAt','values']) && ((newData.child('source').val() === 'gateway') === $recordId.endsWith('_g'))",
                "source": {
                  ".validate": "newData.val() === 'gateway' || newData.val() === 'device'"
                },
                "reportedBy": {
                  ".validate": "newData.val() === auth.uid"
                },
                "receivedAt": {
                  ".validate": "newData.val() === now"
                },
                "deviceTs": {
                  ".validate": "newData.isNumber()"
                },
                "values": {
                  ".validate": "newData.hasChildren()",
                  "temp": {
                    ".validate": "newData.isNumber() && newData.val() > -50 && newData.val() < 150"
                  },
                  "hum": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                  },
                  "smokePpm": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "commands": {
              ".read": "(auth != null) && ((root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) || (root.child('homes').child($homeId).child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active')))",
              ".indexOn": [
                "createdAt"
              ],
              "$cmdId": {
                ".write": "(auth != null) && !data.exists() && newData.exists() && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active') && $cmdId.matches(/^[A-Za-z0-9_-]{8,64}$/)",
                ".validate": "newData.hasChildren(['type','params','createdBy','status','createdAt','ttlMs'])",
                "type": {
                  ".validate": "newData.val() === 'light.set' || newData.val() === 'door.set' || newData.val() === 'alarm.set' || newData.val() === 'mode.set' || newData.val() === 'clothes.set' || newData.val() === 'window.set' || newData.val() === 'fan.set'"
                },
                "params": {
                  ".validate": "newData.hasChildren()",
                  "on": {
                    ".validate": "newData.isBoolean()"
                  },
                  "mode": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
                  },
                  "value": {
                    ".validate": "newData.isNumber()"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "createdBy": {
                  ".validate": "newData.val() === auth.uid"
                },
                "status": {
                  ".write": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active') && data.val() === 'pending' && newData.val() === 'cancelled' && data.parent().child('createdBy').val() === auth.uid && !root.child('homes').child($homeId).child('deviceData').child($deviceId).child('acks').child($cmdId).exists()",
                  ".validate": "(!data.exists() && newData.val() === 'pending') || (data.exists() && newData.val() === 'cancelled')"
                },
                "createdAt": {
                  ".validate": "newData.val() === now"
                },
                "ttlMs": {
                  ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 300000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "acks": {
              ".read": "(auth != null) && ((root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) || (root.child('homes').child($homeId).child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active')))",
              "$cmdId": {
                ".write": "(auth != null) && !data.exists() && newData.exists() && (root.child('homes').child($homeId).child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active')) && root.child('homes').child($homeId).child('deviceData').child($deviceId).child('commands').child($cmdId).exists()",
                ".validate": "newData.hasChildren(['cmdId','result','reportedBy','receivedAt'])",
                "cmdId": {
                  ".validate": "newData.val() === $cmdId"
                },
                "result": {
                  ".validate": "newData.val() === 'ok' || newData.val() === 'failed' || newData.val() === 'rejected' || newData.val() === 'expired'"
                },
                "reportedBy": {
                  ".validate": "newData.val() === auth.uid"
                },
                "receivedAt": {
                  ".validate": "newData.val() === now"
                },
                "deviceTs": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "events": {
              ".read": "(auth != null) && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))",
              ".indexOn": [
                "receivedAt"
              ],
              "$eventId": {
                ".write": "(auth != null) && ((!newData.exists() && (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid)) || (!data.exists() && newData.exists() && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active') && (($eventId.beginsWith('g_') && (root.child('homes').child($homeId).child('members').child(auth.uid).exists() || (root.child('homes').child($homeId).child('meta').child('ownerUid').val() === auth.uid))) || ($eventId.beginsWith('d_') && (root.child('homes').child($homeId).child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid && (root.child('homes').child($homeId).child('devices').child($deviceId).child('status').val() === 'active'))))))",
                ".validate": "$eventId.matches(/^(g|d)_[A-Za-z0-9]{1,16}_[0-9]{1,10}$/) && newData.hasChildren(['type','severity','stream','seq','source','reportedBy','receivedAt']) && ((newData.child('source').val() === 'gateway' && $eventId === 'g_' + newData.child('stream').val() + '_' + newData.child('seq').val()) || (newData.child('source').val() === 'device' && $eventId === 'd_' + newData.child('stream').val() + '_' + newData.child('seq').val()))",
                "type": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
                },
                "severity": {
                  ".validate": "newData.val() === 'info' || newData.val() === 'warn' || newData.val() === 'critical'"
                },
                "stream": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,16}$/)"
                },
                "seq": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999 && (newData.val() % 1 === 0)"
                },
                "source": {
                  ".validate": "newData.val() === 'gateway' || newData.val() === 'device'"
                },
                "reportedBy": {
                  ".validate": "newData.val() === auth.uid"
                },
                "deviceTs": {
                  ".validate": "newData.isNumber()"
                },
                "receivedAt": {
                  ".validate": "newData.val() === now"
                },
                "detail": {
                  ".validate": "newData.isString() && newData.val().length <= 120 && !newData.val().contains('deviceKey')"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        }
      }
    }
  }
}
